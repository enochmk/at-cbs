{
  "name": "@enochmk/cbs-client",
  "version": "2.2.0",
  "description": "CBS (Core Billing System) SOAP API client for AirtelTigo",
  "private": false,
  "author": "Enoch Klufio",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/enochmk/at-cbs.git"
  },
  "homepage": "https://github.com/enochmk/at-cbs#readme",
  "bugs": {
    "url": "https://github.com/enochmk/at-cbs/issues"
  },
  "keywords": [
    "cbs",
    "airteltigo",
    "soap",
    "billing",
    "telecom"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:create-enterprise-customer": "node --env-file-if-exists=.env --import=tsx/esm tests/manual/create-enterprise-customer.ts",
    "test:change-subscriber-status": "tsx tests/manual/change-subscriber-status.ts",
    "test:change-subscriber-offering": "tsx tests/manual/change-subscriber-offering.ts",
    "release": "npm version patch && git push --tags",
    "release:minor": "npm version minor && git push --tags",
    "release:major": "npm version major && git push --tags",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write ."
  },
  "lint-staged": {
    "*.{ts,js}": [
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "axios": "^1.7.0",
    "fast-xml-parser": "^4.5.0",
    "http-errors": "^2.0.0"
  },
  "devDependencies": {
    "@types/http-errors": "^2.0.0",
    "@types/node": "^26.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
