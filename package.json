{
  "name": "@at/cbs",
  "version": "1.0.0",
  "description": "CBS (Core Billing System) SOAP API client for AirtelTigo",
  "private": false,
  "author": "Enoch Klufio",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "npx tsx test-manual.ts",
    "prepublishOnly": "npm run build",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write ."
  },
  "dependencies": {
    "axios": "^1.7.0",
    "fast-xml-parser": "^4.5.0",
    "http-errors": "^2.0.0"
  },
  "devDependencies": {
    "@types/http-errors": "^2.0.0",
    "@types/node": "^26.0.1",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
