# Synthetic CBS hierarchy test data.
# Do not use these values in production. Replace the connection and catalog
# placeholders with values approved for a CBS test environment.

CBS_BASE_URL=https://cbs-test.example.invalid
CBS_USERNAME=replace-with-test-login
CBS_PASSWORD=replace-with-test-password
CBS_REJECT_UNAUTHORIZED=false

# All three keys must be unique in the CBS test environment.
CBS_REGISTER_CUSTOMER_KEY=HTC_TEST_REG_20260812_001
CBS_CUSTOMER_KEY=HTC_TEST_CUSTOMER_20260812_001
CBS_ACCOUNT_KEY=HTC_TEST_ACCOUNT_20260812_001
CBS_SUBSCRIBER_KEY=HTC_TEST_SUBSCRIBER_20260812_001

# Required to create the subscriber. CBS must recognize this number.
MSISDN=replace-with-cbs-test-msisdn
CBS_OFFERING_ID=replace-with-valid-cbs-offering-id
CBS_SUBSCRIBER_PAYMENT_MODE=2

# Customer test record.
CBS_CUSTOMER_TYPE=1
CBS_CUSTOMER_NODE_TYPE=1
CBS_CUSTOMER_CLASS=1
CBS_CUSTOMER_SEGMENT=HTC_TEST
CBS_CUSTOMER_ID_TYPE=TEST_ID
CBS_CUSTOMER_ID_NUMBER=HTC-TEST-20260812-001
CBS_CUSTOMER_FIRST_NAME=HTC
CBS_CUSTOMER_LAST_NAME=Integration Test
CBS_CUSTOMER_MOBILE=replace-with-test-contact
CBS_CUSTOMER_EMAIL=htc-cbs-test-001@example.invalid

# Account test record.
CBS_ACCOUNT_CODE=HTC_TEST_ACCOUNT_CODE_20260812_001
CBS_ACCOUNT_NAME=HTC CBS Integration Test Account
CBS_BILL_CYCLE_TYPE=01
CBS_ACCOUNT_TYPE=1
CBS_PAYMENT_TYPE=1
CBS_ACCOUNT_CLASS=1
CBS_CURRENCY_ID=1054
CBS_ACCOUNT_PAYMENT_METHOD=1
CBS_INITIAL_BALANCE=0
CBS_CREDIT_LIMIT=1000000
CBS_CREDIT_LIMIT_TYPE=C_INITIAL_CREDIT_LIMIT

# Subscriber test record.
CBS_SUBSCRIBER_CLASS=1
CBS_SUBSCRIBER_STATUS=1
CBS_SECONDARY_IDENTITY=replace-with-secondary-test-identity

# Optional query/mutation test values.
CBS_QUERY_KEY_TYPE=customerKey
CBS_QUERY_KEY_VALUE=HTC_TEST_CUSTOMER_20260812_001
CBS_OLD_OFFERING_ID=
CBS_NEW_OFFERING_ID=replace-with-another-valid-cbs-offering-id
CBS_PURCHASE_SEQ=
CBS_NEW_PAYMENT_MODE=1
CBS_PAYMENT_RELATION_KEY=HTC_TEST_PAYREL_20260812_001
CBS_EFFECTIVE_TIME=
CBS_NEW_CREDIT_LIMIT=2000000
CBS_ADD_PAY_RELATION_KEY=HTC_TEST_PAYREL_20260812_001
CBS_PAYMENT_ACCOUNT_KEY=HTC_TEST_ACCOUNT_20260812_001
CBS_PAY_RELATION_PRIORITY=50
CBS_ONLY_PAY_RELATION_FLAG=N
CBS_DELETE_PAY_RELATION_KEY=

# Adjustment-based security-deposit/initial-balance test.
CBS_BALANCE_TYPE=C_MAIN_ACCOUNT
CBS_ADJUSTMENT_AMOUNT=100000
CBS_ADJUSTMENT_TYPE=2
CBS_ADJUSTMENT_REASON_CODE=DNTREQ
CBS_ADJUSTMENT_OP_TYPE=2
